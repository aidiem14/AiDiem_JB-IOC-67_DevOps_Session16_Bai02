<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 1. Ghi log ra console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Ghi log ra file và tự động chia nhỏ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- File log hiện tại -->
        <file>logs/app.log</file>
        <!-- Chính sách chia file theo thời gian và dung lượng -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Tên file lưu trữ sau khi xoay vòng -->
            <fileNamePattern>logs/app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- Dung lượng tối đa mỗi file -->
            <maxFileSize>1KB</maxFileSize>
            <!-- Giữ lịch sử log tối đa 30 ngày -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 3. Kích hoạt cả hai nơi ghi log -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
